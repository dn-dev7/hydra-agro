{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hydra-agro",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
